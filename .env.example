# 复制为 .env 后按需填写；外部服务全部留空时后端走离线分支，可完全离线运行。

DATABASE_URL=sqlite:///./iep_meeting.db
UPLOAD_DIR=./uploads

# 可选：OpenAI 摘要生成（留空则走确定性离线摘要）
OPENAI_API_KEY=

# 可选：pyannote 说话人区分（留空则不作说话人区分）
PYANNOTE_AUTH_TOKEN=

# 可选：Whisper 模型规格（需要 openai-whisper）
WHISPER_MODEL=base

# 可选：加密密钥（32 字节；留空则每次启动随机生成，重启后旧密文不可解）
ENCRYPTION_KEY=

# 可选：SMTP 邮件（留空则不投递，仅返回发送结果）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
